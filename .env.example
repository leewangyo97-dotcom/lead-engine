# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so it must never hold a real value.

# Neon Postgres (pooled HTTP connection string — Neon autosuspends at 5 min idle)
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Gmail — scope is gmail.compose only. Drafts can be created; the mailbox cannot
# be read and nothing can be sent. Obtain the refresh token with `pnpm gmail:auth`.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# GitHub Actions from the site: Enhance, Run now and Discover start workflow
# runs with this. Fine-grained token, this repository only, Actions: read and
# write. Without it each button shows the terminal command instead.
GITHUB_DISPATCH_TOKEN=""
# Optional: owner/repo to dispatch to. Vercel supplies it on deploys.
# GITHUB_DISPATCH_REPO="owner/repo"

# Decision-makers (/people). Both optional: a provider without its key is skipped.
# SEC EDGAR asks automated clients to name themselves: "Lead Engine you@example.com"
SEC_USER_AGENT=""
# GitHub company signals. Actions provides this; set it only to run discovery locally.
GITHUB_TOKEN=""

# Optional: where demo pages are published (default: the GitHub Pages site).
DEMO_BASE_URL=""
